{
  "$defs": {
    "DomainPackRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "DomainPackRef",
      "type": "object"
    },
    "ModelRole": {
      "enum": [
        "extractor",
        "auditor",
        "resolver",
        "offline_judge"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "PipelineSourceRecord": {
      "additionalProperties": false,
      "properties": {
        "extraction_status": {
          "enum": [
            "complete",
            "incomplete",
            "failed"
          ],
          "title": "Extraction Status",
          "type": "string"
        },
        "parser_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
          "title": "Parser Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "sha256",
        "parser_id",
        "parser_version",
        "extraction_status"
      ],
      "title": "PipelineSourceRecord",
      "type": "object"
    },
    "ProviderCallRecord": {
      "additionalProperties": false,
      "properties": {
        "completion_status": {
          "enum": [
            "completed",
            "refused",
            "incomplete"
          ],
          "title": "Completion Status",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "provider_alias": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider Alias",
          "type": "string"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Request Id"
        },
        "retry_count": {
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/ModelRole"
        }
      },
      "required": [
        "role",
        "provider_alias",
        "model_id",
        "provider_request_id",
        "completion_status",
        "input_tokens",
        "output_tokens",
        "latency_ms",
        "retry_count"
      ],
      "title": "ProviderCallRecord",
      "type": "object"
    },
    "StageRecord": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "item_count": {
          "default": 0,
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "stage": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "duration_ms"
      ],
      "title": "StageRecord",
      "type": "object"
    }
  },
  "$id": "https://schemas.creatorsvoice.local/parse-manifest/1.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_version": {
      "exclusiveMinimum": 0,
      "title": "Artifact Version",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "domain_pack": {
      "$ref": "#/$defs/DomainPackRef"
    },
    "locale": {
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-\\d{3})?$",
      "title": "Locale",
      "type": "string"
    },
    "model_routes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Model Routes",
      "type": "object"
    },
    "pipeline_version": {
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$",
      "title": "Pipeline Version",
      "type": "string"
    },
    "prompt_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Versions",
      "type": "object"
    },
    "provider_calls": {
      "items": {
        "$ref": "#/$defs/ProviderCallRecord"
      },
      "title": "Provider Calls",
      "type": "array"
    },
    "readiness_reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Readiness Reason Codes",
      "type": "array"
    },
    "request_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Fingerprint",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "requested_task_types": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requested Task Types",
      "type": "array"
    },
    "schema_version": {
      "const": "parse-manifest/1.0",
      "default": "parse-manifest/1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/PipelineSourceRecord"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRecord"
      },
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "request_fingerprint",
    "artifact_id",
    "artifact_version",
    "created_at",
    "locale",
    "pipeline_version",
    "domain_pack",
    "requested_task_types",
    "prompt_versions",
    "model_routes",
    "sources",
    "stages",
    "provider_calls",
    "readiness_reason_codes"
  ],
  "title": "ParseManifest",
  "type": "object"
}
