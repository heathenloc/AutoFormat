{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/decision-event/1.0",
  "title": "Append-only user decision event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "task_id", "base_version_id",
    "request_id", "kind", "payload", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "decision-event/1.0" },
    "decision_id": { "$ref": "#/$defs/id" },
    "task_id": { "$ref": "#/$defs/id" },
    "base_version_id": { "$ref": "#/$defs/id" },
    "request_id": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["answer", "skip", "defer", "consultation"] },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
  }
}
