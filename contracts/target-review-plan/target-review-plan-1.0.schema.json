{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/target-review-plan/1.0",
  "title": "Non-executable semantic target review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base_version_id", "base_docx_sha256", "rules_snapshot_id", "status", "executable_operations", "rule_reviews", "source_issues"],
  "properties": {
    "schema_version": {"const": "target-review-plan/1.0"},
    "base_version_id": {"type": "string", "minLength": 1},
    "base_docx_sha256": {"$ref": "#/$defs/hash"},
    "rules_snapshot_id": {"type": "string", "minLength": 1},
    "status": {"const": "needs_user_input"},
    "executable_operations": {"type": "array", "maxItems": 0},
    "rule_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "source_requirement_id", "source_version", "requested_scope", "property_id", "value", "status", "estimated_affected_count", "targets"],
        "properties": {
          "rule_id": {"type": "string", "minLength": 1},
          "source_requirement_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "requested_scope": {"enum": ["selection", "paragraph", "same_kind", "document"]},
          "property_id": {"type": "string", "minLength": 1},
          "value": {},
          "status": {"enum": ["needs_user_input", "unsupported_property", "pending_conflict", "pending_condition", "check_only", "unsupported"]},
          "estimated_affected_count": {"type": "null"},
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["object_id", "xml_path", "text_sha256", "text_preview", "role_candidate", "role_evidence", "disposition"],
              "properties": {
                "object_id": {"type": "string", "pattern": "^p:[0-9]{6,}$"},
                "xml_path": {"type": "string", "pattern": "^body/"},
                "text_sha256": {"$ref": "#/$defs/hash"},
                "text_preview": {"type": "string", "maxLength": 120},
                "role_candidate": {"enum": ["body_candidate", "heading_candidate", "table_cell", "unclassified"]},
                "role_evidence": {"type": "string", "minLength": 1},
                "disposition": {"enum": ["blocked_complex_content", "needs_body_confirmation", "needs_classification", "excluded_candidate"]}
              }
            }
          }
        }
      }
    },
    "source_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_requirement_id", "status", "reason", "next_action"],
        "properties": {
          "source_requirement_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
