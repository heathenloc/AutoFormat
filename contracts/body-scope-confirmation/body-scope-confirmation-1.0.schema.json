{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/body-scope-confirmation/1.0",
  "title": "Confirm the scope of a reviewed body alignment rule",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "expected_base_docx_sha256", "review_sha256", "body_object_ids", "excluded_object_ids", "raw_answer"],
  "properties": {
    "schema_version": {"const": "body-scope-confirmation/1.0"},
    "request_id": {"$ref": "#/$defs/id"},
    "expected_base_docx_sha256": {"$ref": "#/$defs/hash"},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "body_object_ids": {"type": "array", "minItems": 1, "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/object_id"}},
    "excluded_object_ids": {"type": "array", "maxItems": 5000, "uniqueItems": true, "items": {"$ref": "#/$defs/object_id"}},
    "raw_answer": {"type": "string", "minLength": 1, "maxLength": 2048}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "object_id": {"type": "string", "pattern": "^p:[0-9]{6,}$"}
  }
}
