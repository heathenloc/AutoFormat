{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/task-intake/1.1",
  "title": "Academic task intake with initial draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "phase", "task_id", "base_version_id",
    "base_docx_sha256", "initial_version_id", "initial_docx_sha256",
    "initial_format_status", "pending_count", "parse_artifact_id",
    "parse_readiness", "requirement_count", "replayed", "next_action"
  ],
  "properties": {
    "schema_version": {"const": "task-intake/1.1"},
    "status": {"const": "ready"},
    "phase": {"const": "initial_draft_ready"},
    "task_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "base_version_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "base_docx_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "initial_version_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "initial_docx_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "initial_format_status": {"type": "string", "enum": ["verified", "partial", "unassessed"]},
    "pending_count": {"type": "integer", "minimum": 0},
    "parse_artifact_id": {"type": "string", "minLength": 1},
    "parse_readiness": {"type": "string", "enum": ["complete", "usable_with_warnings", "incomplete"]},
    "requirement_count": {"type": "integer", "minimum": 0},
    "replayed": {"type": "boolean"},
    "next_action": {"type": "string", "minLength": 1}
  }
}
