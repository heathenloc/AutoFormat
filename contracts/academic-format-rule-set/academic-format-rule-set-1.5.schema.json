        "$ref": "#/$defs/AcademicFormatRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/AcademicFormatIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/AcademicRuleRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/AcademicRuleConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/AcademicRuleFragment"
      },
      "title": "Fragments",
      "type": "array"
    },
    "candidate_reviews": {
      "items": {
        "$ref": "#/$defs/AcademicCandidateReview"
      },
      "title": "Candidate Reviews",
      "type": "array"
    }
