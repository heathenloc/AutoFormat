        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/AcademicTarget"
        },
        "property_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/AcademicValue"
        },
        "character_scope": {
          "default": "all",
          "maxLength": 200,
          "minLength": 1,
          "title": "Character Scope",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "requested_scope": {
          "enum": [
            "selection",
            "paragraph",
            "same_kind",
            "document"
          ],
          "title": "Requested Scope",
          "type": "string"
        },
        "effective_scope": {
          "enum": [
            "selection",
            "paragraph",
            "same_kind",
            "document"
          ],
          "title": "Effective Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "pending_conflict",
            "pending_condition",
            "check_only",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "resolution_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Ref"
        },
        "semantics": {
          "$ref": "#/$defs/AcademicRuleSemantics"
        }
