    "AcademicRuleConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Conflict Id",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
