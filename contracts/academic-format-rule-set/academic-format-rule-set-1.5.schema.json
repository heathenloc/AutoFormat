          "maxItems": 2,
          "minItems": 2,
          "title": "Rule Ids",
          "type": "array"
        },
        "intersection": {
          "$ref": "#/$defs/AcademicRuleScope"
        },
        "certainty": {
          "enum": [
            "definite",
            "potential"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "rule_ids",
        "intersection",
        "certainty",
        "reason"
