          "type": "string"
        },
        "source_artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "source_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
