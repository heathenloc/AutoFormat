        "source_requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "covered",
            "rejected",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "property_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        },
        "rule_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        }
      },
      "required": [
        "source_requirement_id",
        "status",
        "reason_code",
        "reason",
        "evidence_ids"
      ],
      "title": "AcademicCandidateReview",
      "type": "object"
    },
    "AcademicCondition": {
      "additionalProperties": false,
      "properties": {
        "original_text": {
          "title": "Original Text",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "original_text",
        "resolution",
        "reason"
      ],
      "title": "AcademicCondition",
      "type": "object"
    },
    "AcademicConstraint": {
      "additionalProperties": false,
      "properties": {
        "operator": {
          "default": "eq",
