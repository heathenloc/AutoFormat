            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "table": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        }
      },
      "title": "SourceLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "academic-format-rule-set/1.5",
      "title": "Schema Version",
      "type": "string",
      "const": "academic-format-rule-set/1.5"
    },
    "source_artifact_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Artifact Id",
      "type": "string"
    },
    "source_artifact_version": {
      "exclusiveMinimum": 0,
      "title": "Source Artifact Version",
      "type": "integer"
    },
    "domain_pack": {
      "$ref": "#/$defs/DomainPackRef"
