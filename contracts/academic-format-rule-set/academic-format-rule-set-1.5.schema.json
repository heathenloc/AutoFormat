            "eq",
            "between",
            "gte",
            "lte",
            "ne"
          ],
          "title": "Operator",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        }
      },
      "title": "AcademicConstraint",
      "type": "object"
    },
    "AcademicFormatIssue": {
      "additionalProperties": false,
      "properties": {
        "source_requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "needs_source_classification",
            "pending_conflict",
            "pending_condition",
            "evidence_unverified",
            "value_evidence_mismatch",
            "unsupported",
            "check_only",
            "parse_incomplete",
            "needs_value",
            "ambiguous_target"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "next_action": {
          "minLength": 1,
          "title": "Next Action",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcademicTarget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "property_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        }
      },
      "required": [
        "source_requirement_id",
        "status",
        "reason",
        "next_action",
        "evidence_ids"
      ],
      "title": "AcademicFormatIssue",
      "type": "object"
    },
    "AcademicFormatRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "academic-format-rule/1.1",
          "type": "string"
        },
        "rule_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "source_requirement_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Requirement Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "brief_explicit",
            "template_observation_confirmed",
            "user_feedback"
