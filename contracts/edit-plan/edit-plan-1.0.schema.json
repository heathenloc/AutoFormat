{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/edit-plan/1.0",
  "title": "Confirmed body paragraph alignment edit plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "base_version_id", "base_docx_sha256", "rules_snapshot_id", "scope_decision_id", "review_sha256", "rule_id", "source_requirement_id", "source_version", "requested_scope", "value", "estimated_affected_count", "excluded_object_ids", "operations"],
  "properties": {
    "schema_version": {"const": "edit-plan/1.0"},
    "plan_id": {"$ref": "#/$defs/hash"},
    "base_version_id": {"type": "string", "minLength": 1},
    "base_docx_sha256": {"$ref": "#/$defs/hash"},
    "rules_snapshot_id": {"type": "string", "minLength": 1},
    "scope_decision_id": {"type": "string", "minLength": 1},
    "review_sha256": {"$ref": "#/$defs/hash"},
    "rule_id": {"type": "string", "minLength": 1},
    "source_requirement_id": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "requested_scope": {"const": "same_kind"},
    "value": {"enum": ["left", "center", "right", "both"]},
    "estimated_affected_count": {"type": "integer", "minimum": 1},
    "excluded_object_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/object_id"}},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation_id", "rule_id", "object_id", "xml_path", "expected_paragraph_text_sha256", "property_id", "before_value", "after_value", "effective_scope", "status"],
        "properties": {
          "operation_id": {"$ref": "#/$defs/hash"},
          "rule_id": {"type": "string", "minLength": 1},
          "object_id": {"$ref": "#/$defs/object_id"},
          "xml_path": {"type": "string", "pattern": "^body/"},
          "expected_paragraph_text_sha256": {"$ref": "#/$defs/hash"},
          "property_id": {"const": "paragraph.alignment"},
          "before_value": {"type": ["string", "null"]},
          "after_value": {"enum": ["left", "center", "right", "both"]},
          "effective_scope": {"const": "paragraph"},
          "status": {"const": "pending"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "object_id": {"type": "string", "pattern": "^p:[0-9]{6,}$"}
  }
}
