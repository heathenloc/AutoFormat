        "rule_id",
        "source_requirement_id",
        "source_kind",
        "source_artifact_id",
        "source_version",
        "evidence_refs",
        "target",
        "property_id",
        "value",
        "requested_scope",
        "effective_scope",
        "status",
        "reason"
