          "type": "string"
        },
        "feedback_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Feedback Id",
          "type": "string"
        },
        "expected_parse_result_id": {
          "pattern": "^[a-f0-9]{64}$",
