{
  "$defs": {
    "AcademicRuleScope": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "additionalProperties": {
            "$ref": "#/$defs/ScopeAxis"
          },
          "propertyNames": {
            "maxLength": 200,
            "minLength": 1
          },
          "title": "Axes",
          "type": "object"
        }
      },
      "required": [
        "axes"
      ],
      "title": "AcademicRuleScope",
      "type": "object"
    },
    "DocxTextRange": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Object Id",
          "type": "string"
        },
        "start_utf16": {
          "minimum": 0,
          "title": "Start Utf16",
          "type": "integer"
        },
        "length_utf16": {
          "minimum": 1,
          "title": "Length Utf16",
          "type": "integer"
        },
        "matched_text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Matched Text",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "start_utf16",
        "length_utf16",
        "matched_text"
      ],
      "title": "DocxTextRange",
      "type": "object"
    },
    "FeedbackAnalysis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "feedback-analysis/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "analysis_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Analysis Id",
          "type": "string"
        },
        "interpretation": {
          "$ref": "#/$defs/FeedbackParseResult"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confirmed_review_ids": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Confirmed Review Ids",
          "type": "array"
        },
        "decision_count": {
          "default": 0,
          "maximum": 128,
          "minimum": 0,
          "title": "Decision Count",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "analysis_id",
        "interpretation"
      ],
      "title": "FeedbackAnalysis",
      "type": "object"
    },
    "FeedbackCompiledRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Rule Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "academic",
            "feedback"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Source Rule Id",
          "type": "string"
        },
        "feedback_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback Id"
        },
        "candidate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "origin_version_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Origin Version Id",
          "type": "string"
        },
        "property_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Property Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FormatValue"
        },
        "original_requirement": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Original Requirement",
          "type": "string"
        },
        "evidence_quotes": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 512,
          "title": "Evidence Quotes",
          "type": "array"
        },
        "requested_scope": {
          "enum": [
            "selection",
            "paragraph",
            "same_kind",
            "document"
          ],
          "title": "Requested Scope",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelectionAnchor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rule_id",
        "source_kind",
        "source_rule_id",
        "origin_version_id",
        "property_id",
        "value",
        "original_requirement",
        "evidence_quotes",
        "requested_scope"
      ],
      "title": "FeedbackCompiledRule",
      "type": "object"
    },
    "FeedbackConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "existing_rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Existing Rule Ids",
          "type": "array"
        },
        "property_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Property Id",
          "type": "string"
        },
        "affected_target_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Affected Target Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "candidate_id",
        "existing_rule_ids",
        "property_id",
        "affected_target_ids",
        "reason"
      ],
      "title": "FeedbackConflict",
      "type": "object"
    },
    "FeedbackParseResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "feedback-parse-result/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "result_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Task Id",
          "type": "string"
        },
        "feedback_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Feedback Id",
          "type": "string"
        },
        "version_context_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Version Context Id",
          "type": "string"
        },
        "source_submission_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Submission Sha256",
          "type": "string"
        },
        "parser_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Parser Id",
          "type": "string"
        },
        "parser_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Parser Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "execution_defect",
            "new_rule",
            "clarification_needed",
            "question",
            "out_of_scope"
          ],
          "title": "Kind",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/FeedbackRuleCandidate"
          },
          "maxItems": 64,
          "title": "Candidates",
          "type": "array"
        },
        "understood": {
          "items": {
            "$ref": "#/$defs/FeedbackPartialRule"
          },
          "maxItems": 64,
          "title": "Understood",
          "type": "array"
        },
        "existing_rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "maxItems": 512,
          "title": "Existing Rule Ids",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missing Fields",
          "type": "array"
        },
        "scope_reviews": {
          "items": {
            "$ref": "#/$defs/ScopeReview"
          },
          "maxItems": 64,
          "title": "Scope Reviews",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/FeedbackConflict"
          },
          "maxItems": 64,
          "title": "Conflicts",
          "type": "array"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "result_id",
        "task_id",
        "feedback_id",
        "version_context_id",
        "source_submission_sha256",
        "parser_id",
        "parser_version",
        "kind",
        "reason"
      ],
      "title": "FeedbackParseResult",
      "type": "object"
    },
    "FeedbackPartialRule": {
      "additionalProperties": false,
      "description": "Fields understood so far; never a candidate that may be executed.",
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "property_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Property Id"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormatValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "semantic_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Role"
        },
        "requested_scope": {
          "anyOf": [
            {
              "enum": [
                "selection",
                "paragraph",
                "same_kind",
                "document"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Scope"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "FeedbackPartialRule",
      "type": "object"
    },
    "FeedbackRuleCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "property_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Property Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FormatValue"
        },
        "requested_scope": {
          "enum": [
            "selection",
            "paragraph",
            "same_kind",
            "document"
          ],
          "title": "Requested Scope",
          "type": "string"
        },
        "semantic_role": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Role"
        },
        "character_scope": {
          "default": "all",
          "enum": [
            "all",
            "chinese",
            "latin",
            "digits",
            "complex_script",
            "other"
          ],
          "title": "Character Scope",
          "type": "string"
        },
        "applicability_scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/AcademicRuleScope"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "candidate_id",
        "property_id",
        "value",
        "requested_scope"
      ],
      "title": "FeedbackRuleCandidate",
      "type": "object"
    },
    "FeedbackRuleConflictReview": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Conflict Id",
          "type": "string"
        },
        "feedback_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Feedback Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "incoming_rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Incoming Rule Id",
          "type": "string"
        },
        "existing_rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Existing Rule Id",
          "type": "string"
        },
        "property_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Property Id",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/FeedbackRuleSpan"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Spans",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "enum": [
              "keep_rule",
              "local_exception",
              "update_rule"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Allowed Actions",
          "type": "array"
        },
        "resolution": {
          "anyOf": [
            {
              "enum": [
                "keep_rule",
                "local_exception",
                "update_rule"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "decision_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "conflict_id",
        "feedback_id",
        "candidate_id",
        "incoming_rule_id",
        "existing_rule_id",
        "property_id",
        "spans",
        "allowed_actions",
        "reason"
      ],
      "title": "FeedbackRuleConflictReview",
      "type": "object"
    },
    "FeedbackRuleFragment": {
      "additionalProperties": false,
      "properties": {
        "fragment_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fragment Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Rule Id",
          "type": "string"
        },
        "property_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Property Id",
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/FeedbackRuleSpan"
        },
        "value": {
          "$ref": "#/$defs/FormatValue"
        },
        "status": {
          "enum": [
            "verified",
            "pending_conflict",
            "pending_scope",
            "pending_basis",
            "pending_target",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "conflict_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
            "type": "string"
          },
          "maxItems": 512,
          "title": "Conflict Ids",
          "type": "array"
        },
        "decision_ids": {
          "items": {
            "pattern": "^[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Decision Ids",
          "type": "array"
        }
      },
      "required": [
        "fragment_id",
        "rule_id",
        "property_id",
        "span",
        "value",
        "status"
      ],
      "title": "FeedbackRuleFragment",
      "type": "object"
    },
    "FeedbackRuleSpan": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "title": "Object Id",
          "type": "string"
        },
        "start_utf16": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Utf16"
        },
        "length_utf16": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length Utf16"
        }
      },
      "required": [
        "object_id"
      ],
      "title": "FeedbackRuleSpan",
      "type": "object"
    },
    "FeedbackRulesDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Request Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Task Id",
          "type": "string"
        },
        "base_version_id": {
          "pattern": "^[a-f0-9]{32}$",
