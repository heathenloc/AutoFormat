            "update_rule"
          ],
          "title": "Action",
          "type": "string"
        },
        "expected_snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "base_version_id",
        "expected_base_docx_sha256",
        "expected_context_id",
        "feedback_id",
        "expected_parse_result_id",
        "schema_version",
        "conflict_id",
        "action",
        "expected_snapshot_id"
      ],
      "title": "FeedbackRulesDecision",
      "type": "object"
    },
    "FeedbackRulesSnapshotV2": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "feedback-rule-snapshot/1.2",
          "title": "Schema Version",
          "type": "string"
        },
        "compiler_version": {
          "const": "feedback-rules/1.2",
          "default": "feedback-rules/1.2",
          "title": "Compiler Version",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Task Id",
          "type": "string"
        },
        "base_version_id": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Base Version Id",
          "type": "string"
        },
        "base_docx_sha256": {
          "pattern": "^[a-f0-9]{64}$",
