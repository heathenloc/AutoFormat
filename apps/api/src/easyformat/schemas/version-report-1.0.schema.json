{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/version-report/1.0",
  "title": "Versioned EasyFormat facts and user report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "version_id", "parent_version_id",
    "created_at", "input", "output_docx_sha256", "preview",
    "rules", "changes_this_round", "changes_cumulative",
    "decisions", "issues", "summary"
  ],
  "properties": {
    "schema_version": { "const": "version-report/1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "version_id": { "type": "string", "minLength": 1 },
    "parent_version_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_docx_sha256", "brief_version_id", "rules_snapshot_id",
        "edit_plan_id", "template_version_id", "decision_version_id"
      ],
      "properties": {
        "source_docx_sha256": { "$ref": "#/$defs/hash" },
        "brief_version_id": { "$ref": "#/$defs/nonempty" },
        "rules_snapshot_id": { "$ref": "#/$defs/nonempty" },
        "edit_plan_id": { "$ref": "#/$defs/nonempty" },
        "template_version_id": { "type": ["string", "null"] },
        "decision_version_id": { "type": ["string", "null"] }
      }
    },
    "output_docx_sha256": { "$ref": "#/$defs/hash" },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "renderer_id", "renderer_version", "font_fingerprint"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonempty" },
        "renderer_id": { "$ref": "#/$defs/nonempty" },
        "renderer_version": { "$ref": "#/$defs/nonempty" },
        "font_fingerprint": { "$ref": "#/$defs/nonempty" }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "changes_this_round": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "changes_cumulative": { "type": "array", "items": { "$ref": "#/$defs/change" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "delivery_status", "format_status", "total_rules", "status_counts",
        "this_round_change_count", "cumulative_change_count", "pending_count", "note"
      ],
      "properties": {
        "delivery_status": { "const": "ready" },
        "format_status": { "enum": ["verified", "partial", "unassessed"] },
        "total_rules": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "this_round_change_count": { "type": "integer", "minimum": 0 },
        "cumulative_change_count": { "type": "integer", "minimum": 0 },
        "pending_count": { "type": "integer", "minimum": 0 },
        "note": { "$ref": "#/$defs/nonempty" }
      }
    }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "value": { "type": ["string", "number", "boolean", "object", "null"] },
    "scope": { "enum": ["selection", "paragraph", "same_kind", "document"] },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_artifact_id", "source_version", "locator", "quote"],
      "properties": {
        "source_artifact_id": { "$ref": "#/$defs/nonempty" },
        "source_version": { "$ref": "#/$defs/nonempty" },
        "locator": { "$ref": "#/$defs/nonempty" },
        "quote": { "$ref": "#/$defs/nonempty" }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "rule_id", "source_kind", "source_artifact_id", "source_version",
        "original_requirement", "evidence_refs", "object_id", "semantic_role",
        "property_id", "requested_scope", "effective_scope", "before_value",
        "after_value", "status", "reason", "next_action", "decision_id",
        "verification_ref"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/nonempty" },
        "source_kind": {
          "enum": ["brief_explicit", "template_observation_confirmed", "user_feedback"]
        },
        "source_artifact_id": { "$ref": "#/$defs/nonempty" },
        "source_version": { "$ref": "#/$defs/nonempty" },
        "original_requirement": { "$ref": "#/$defs/nonempty" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "object_id": { "type": ["string", "null"] },
        "semantic_role": { "$ref": "#/$defs/nonempty" },
        "property_id": { "$ref": "#/$defs/nonempty" },
        "requested_scope": { "$ref": "#/$defs/scope" },
        "effective_scope": { "$ref": "#/$defs/scope" },
        "before_value": { "$ref": "#/$defs/value" },
        "after_value": { "$ref": "#/$defs/value" },
        "status": {
          "enum": [
            "modified_verified", "already_satisfied", "pending_conflict",
            "pending_condition", "needs_user_input", "unsupported_property",
            "field_refresh_pending", "validation_failed", "check_only", "skipped"
          ]
        },
        "reason": { "$ref": "#/$defs/nonempty" },
        "next_action": { "type": ["string", "null"] },
        "decision_id": { "type": ["string", "null"] },
        "verification_ref": { "type": ["string", "null"] }
      }
    },
    "change": {
      "type": "object", "additionalProperties": false,
      "required": [
        "change_id", "rule_id", "object_id", "property_id",
        "before_value", "after_value", "effective_scope",
        "validation_status", "verification_ref"
      ],
      "properties": {
        "change_id": { "$ref": "#/$defs/nonempty" },
        "rule_id": { "$ref": "#/$defs/nonempty" },
        "object_id": { "$ref": "#/$defs/nonempty" },
        "property_id": { "$ref": "#/$defs/nonempty" },
        "before_value": { "$ref": "#/$defs/value" },
        "after_value": { "$ref": "#/$defs/value" },
        "effective_scope": { "$ref": "#/$defs/scope" },
        "validation_status": { "enum": ["verified", "pending_manual_check"] },
        "verification_ref": { "$ref": "#/$defs/nonempty" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "question_id", "raw_answer", "normalized_choice"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/nonempty" },
        "question_id": { "$ref": "#/$defs/nonempty" },
        "raw_answer": { "$ref": "#/$defs/nonempty" },
        "normalized_choice": { "$ref": "#/$defs/nonempty" }
      }
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "status", "rule_id", "object_id", "reason", "next_action"],
      "properties": {
        "issue_id": { "$ref": "#/$defs/nonempty" },
        "status": {
          "enum": [
            "needs_user_input", "blocked_conflict", "ambiguous_target",
            "unsupported_property", "field_refresh_pending", "validation_failed",
            "check_only"
          ]
        },
        "rule_id": { "type": ["string", "null"] },
        "object_id": { "type": ["string", "null"] },
        "reason": { "$ref": "#/$defs/nonempty" },
        "next_action": { "$ref": "#/$defs/nonempty" }
      }
    }
  }
}
