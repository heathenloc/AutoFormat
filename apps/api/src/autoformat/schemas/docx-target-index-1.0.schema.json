{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyformat.local/contracts/docx-target-index/1.0",
  "title": "Read-only DOCX paragraph target index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sha256", "paragraph_count", "paragraphs"],
  "properties": {
    "schema_version": {"const": "docx-target-index/1.0"},
    "sha256": {"$ref": "#/$defs/hash"},
    "paragraph_count": {"type": "integer", "minimum": 0},
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object_id", "xml_path", "style_id", "text_sha256", "text_preview", "is_empty", "requires_manual_targeting", "role_candidate", "role_evidence", "direct_alignment"],
        "properties": {
          "object_id": {"type": "string", "pattern": "^p:[0-9]{6,}$"},
          "xml_path": {"type": "string", "pattern": "^body/"},
          "style_id": {"type": ["string", "null"]},
          "text_sha256": {"$ref": "#/$defs/hash"},
          "text_preview": {"type": "string", "maxLength": 120},
          "is_empty": {"type": "boolean"},
          "requires_manual_targeting": {"type": "boolean"},
          "role_candidate": {"enum": ["body_candidate", "heading_candidate", "table_cell", "unclassified"]},
          "role_evidence": {"enum": ["normal_style_only", "built_in_heading_style", "inside_table", "empty_paragraph", "complex_or_hidden_content", "numbering_properties", "no_reliable_body_role"]},
          "direct_alignment": {"type": ["string", "null"], "maxLength": 64}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
